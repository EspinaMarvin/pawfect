<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D1EDD3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER WITH LOGO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#5C7057"
            android:gravity="center"
            android:padding="12dp">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/logo_pawfect"
                android:layout_marginEnd="10dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About PAWFECT MATCH"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- BODY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Adopt. Love. Belong."
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#5C7057"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginBottom="16dp">
                <TextView android:text="Our Purpose" android:textStyle="bold" android:textSize="15sp" android:textColor="#5C7057" android:layout_marginBottom="8dp"/>
                <TextView android:text="PAWFECT MATCH is a mobile application dedicated to rescuing and rehoming stray cats and dogs by connecting them with caring individuals and families in the community. Our goal is to reduce the number of homeless animals, promote compassion, and ensure every pet finds a safe, loving, and permanent home." android:textSize="14sp" android:lineSpacingExtra="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="18dp"
                android:layout_marginBottom="16dp">
                <TextView android:text="Our Team — Group 3" android:textStyle="bold" android:textSize="15sp" android:textColor="#5C7057" android:layout_marginBottom="8dp"/>
                <TextView android:text="Leader: Espina, Marvin\n\nMembers:\nAlarin, John Boyet\nAlipit, Prince\nBendulo, Joaquin\nBulatao, Kimberly\nCrispino, Pauleen\nGarcia, Ella Rayne\nGuarico, Jhamez Stanley\nLopez, Ishshah\nLozada, Ysabel" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ACC5A6"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView android:text="Contact Us" android:textStyle="bold" android:textSize="15sp" android:textColor="#333333" android:layout_marginBottom="8dp"/>
                <TextView android:text="📍 San Pedro, Laguna, Philippines\n📧 contact@pawfectmatch.ph\n📞 +63 9XX-XXX-XXXX" android:textSize="14sp" android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- FOOTER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#5C7057"
            android:padding="8dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="© 2026 PAWFECT MATCH — Adopt. Love. Belong."
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
