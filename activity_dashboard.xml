<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D1EDD3"
    android:orientation="vertical">

    <!-- HEADER: Logo Left + Menu Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#5C7057"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/logo_pawfect"
            android:layout_marginStart="8dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="  PAWFECT MATCH"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/menuSpinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"/>
    </LinearLayout>

    <!-- BODY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🐾 Longest Waiting Friends"
            android:textColor="#5C7057"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Dog Card 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="10dp"
                android:elevation="2dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:src="@drawable/pet_dog1"/>
                <TextView android:text="Buster" android:textStyle="bold" android:gravity="center" android:layout_marginTop="6dp"/>
                <TextView android:text="3 years • San Pedro, Laguna" android:textSize="12sp" android:gravity="center"/>
            </LinearLayout>

            <!-- Cat Card 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="10dp"
                android:elevation="2dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:src="@drawable/pet_cat1"/>
                <TextView android:text="Whiskers" android:textStyle="bold" android:gravity="center" android:layout_marginTop="6dp"/>
                <TextView android:text="2 years • Calamba, Laguna" android:textSize="12sp" android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <!-- Dog Card 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="10dp"
                android:elevation="2dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:src="@drawable/pet_dog2"/>
                <TextView android:text="Max" android:textStyle="bold" android:gravity="center" android:layout_marginTop="6dp"/>
                <TextView android:text="4 years • Biñan, Laguna" android:textSize="12sp" android:gravity="center"/>
            </LinearLayout>

            <!-- Cat Card 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="10dp"
                android:elevation="2dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:src="@drawable/pet_cat2"/>
                <TextView android:text="Luna" android:textStyle="bold" android:gravity="center" android:layout_marginTop="6dp"/>
                <TextView android:text="1.5 years • Santa Rosa, Laguna" android:textSize="12sp" android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnViewAll"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="#89A482"
            android:text="Browse All Pets"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- FOOTER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#5C7057"
        android:padding="8dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 2026 PAWFECT MATCH"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"/>
    </LinearLayout>
</LinearLayout>
